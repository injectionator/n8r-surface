{
  "name": "n8r-surface",
  "version": "0.1.0-experimental.2",
  "private": true,
  "description": "Experimental AI Surface Model library and Codex research command",
  "bin": {
    "n8r-surface": "./dist/cli.js"
  },
  "type": "module",
  "license": "Apache-2.0 AND CC-BY-4.0",
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./examples/*": "./examples/researcher/*",
    "./contracts/*": "./docs/n8r-surface/*"
  },
  "files": [
    "dist",
    "docs/n8r-surface",
    "examples/researcher",
    "LICENSE",
    "LICENSE-DOCS",
    "LICENSING.md",
    "plugins/n8r-surface"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run check:version && npm run build && npm run check:skill && node --test tests/*.test.mjs",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "prepack": "npm run build",
    "pack:candidates": "node scripts/pack-candidates.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:release": "node scripts/check-release.mjs",
    "acceptance:skill": "node scripts/skill-acceptance/run.mjs",
    "build:skill": "node scripts/build-skill.mjs",
    "check:skill": "node scripts/build-skill.mjs --check"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@types/node": "22.20.5",
    "esbuild": "0.25.12",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/injectionator/n8r-surface.git"
  },
  "homepage": "https://github.com/injectionator/n8r-surface#readme",
  "bugs": {
    "url": "https://github.com/injectionator/n8r-surface/issues"
  }
}
